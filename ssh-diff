#!/bin/bash
#
# ssh-diff - diff two files, allowing scp-like paths
# Author: Jeremy Dolan (2026/04/27)

set -u

usage() {
    cat >&2 <<EOF
Usage: ssh-diff file1 file2
    diff two files, allowing scp-like paths of the form [user@]ssh-host:path
    Filenames containing ':' can be explicitly marked as local by including a
        '/' in the path before the ':', for example: "./file:name"
EOF
}

if [ $# -ne 2 ]; then
    usage
    exit 2
fi

# True if $1 looks like a remote spec: contains ':' before any '/'.
# IPv6 probably breaks this
is_remote() {
    local before_slash=${1%%/*}
    [[ $before_slash == *:* ]]
}

# Print the path that diff should use for path spec $1, fetching to $2 via ssh if spec is remote.
fetch() {
    if is_remote "$1"; then
        local host=${1%%:*}
        local path=${1#*:}
        ssh "$host" cat -- "$(printf '%q' "$path")" > "$2" || return
        echo "$2"
    else
        [ -r "$1" ] || return
        echo "$1"
    fi
}

tmp=$(mktemp -d) || exit 3
readonly tmp
trap 'rm -rf -- "$tmp"' EXIT

path_1=$(fetch "$1" "$tmp/a") || { echo "${0##*/}: failed to read $1" >&2; exit 3; }
path_2=$(fetch "$2" "$tmp/b") || { echo "${0##*/}: failed to read $2" >&2; exit 3; }

diff -u --color=auto --label "$1" --label "$2" "$path_1" "$path_2"
