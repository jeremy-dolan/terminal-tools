#!/bin/bash

###############################################################################
## logininfo - Print some terminal, host, and shell info at login            ##
## Jeremy Dolan <https://jeremydolan.net>                                    ##
## This work is public domain. The author hereby releases all copyright.     ##
##                                                                           ##
## Run from ~/.bash_login (bash) or ~/.zlogin (zsh) to display on login.     ##
## Or, for full output in login shells, and only system info in subshells,   ##
## run from your shell's rc file with "--brief" appended as appropriate      ##
##     e.g.: logininfo $( [[ $0 != -* ]] && echo "--brief" )                 ##
###############################################################################

show_color=1            # color output?
always_color=1          # even when --brief?
ruler_color="95"        # floral pink
bannercolor="93"        # pastoral yellow
stats_color="36"        # mossy teal

show_ruler=1            # draw a "ruler" to show terminal width?
always_ruler=0          # even when --brief?
ruler_autowidth=1       # stretch the ruler to fill the entire terminal width
ruler_width=80          # reference width used if ruler_autowidth=0

show_banner=1           # draw a hostname banner with figlet?
always_banner=0         # even when --brief?
figlet_font="standard"  # end of this script shows some suitable alternatives

#######################
## end configuration ##
#######################

terminal_width="$(tput cols)"
argument="$1"

main() {
    if show ruler; then
        if [ $ruler_autowidth -eq 1 ]; then
            draw_ruler "$terminal_width"
        else
            draw_ruler "$ruler_width"
        fi
    fi

    if show banner; then
        draw_banner
    fi

    draw_status
    reset_color
}


# check if we should show the feature passed as $1 (return 0, success, if yes)
show() {
    # eval is the best way to substitute into a var name with POSIX sh?
    eval "show_feature=\$show_${1}"
    eval "always_feature=\$always_${1}"

    if [ "$show_feature" -eq 1 ]; then
        if ! brief || [ "$always_feature" -eq 1 ]; then
            return 0
        fi
    fi
    return 1
}


draw_ruler() {
    local width=$1
    local tens ones

    # 10s row: (width/10) tens-place digits [floor division]
    # %10d: right-aligned digit in a 10-wide field
    printf -v tens '%10d' $(seq 1 $(( width / 10 )))

    # 1s row: repeat 1234567890 (width/10)-times [+9 is ceiling division trick]
    # %.0s: 0-width string as a null op (prints args $2 .. $n with format $1)
    printf -v ones '1234567890%.0s' $(seq 1 $(( (width+9)/10 )) )

    if show color; then printf "\033[%sm" "$ruler_color"; fi
    printf '%s\n%s\n' "$tens" "${ones:0:$width}"  # trims overshoot for $ones
    if show color; then printf "\033[m"; fi
}


draw_banner() { (
    if show color; then
        printf "\033[%sm" "$bannercolor"
    fi

    if [ -f ~/.nofiglet ]; then
        fig_name=""
    elif [ "$(which figlet)" ]; then
        fig_name="figlet"
    elif [ "$(which pyfiglet)" ]; then
        fig_name="pyfiglet"
    elif [ "$(which figlet.pl)" ]; then
        fig_name="figlet.pl"
    else
        fig_name=""
        name=$(basename "$0")
        echo "$name: No figlet found, skipping hostname banner."
        echo "$name: Consider 'brew install figlet' or 'pip install pyfiglet'"
        echo "$name: Or 'touch ~/.nofiglet' to silence this message."
    fi

    if [ "$fig_name" ]; then
        "$fig_name" -f "$figlet_font" "$(hostname -s)" |
            grep '\S' # remove figlet's extra spacing line
    fi
) }


draw_status() { (
    if show color; then
        printf "\033[%sm" "$stats_color"
    fi

    # MacOS version
    if [[ "$(uname)" == "Darwin" ]]; then
        product="$(sw_vers --productName)"
        version="$(sw_vers --productVersion)"
        #vers_extras="$(sw_vers --productVersionExtra)"
        #build="$(sw_vers --buildVersion)"
        #echo -n "$product" "$version""$vers_extras" "(""$build"")"
        /bin/echo -n "$product" "$version" "/ "
    fi

    # cross-platform
    line1="$(uname -sr)   tty=$(tty)   TERM=$TERM"
    if [ -e /proc/loadavg ]; then
        # slice in the running/total process count:
        procs=$(awk '{ print $4, "procs" }' /proc/loadavg)
        line2=$(uptime | \
            sed -e "s@user\(s\?\),  load average@user\\1,  $procs,  loadavg@")
    else
        line2=$(uptime)
    fi
    printf "%s\n%s\n" "$line1" "$line2"
) }


reset_color() {
    show color && printf "\033[m"
}


brief() {
    if [ "$argument" = "--brief" ]; then
        return 0
    else
        return 1
    fi
}


main


# Some figlet fonts that work well for a hostname:
#                    __ _
# standard          / _| | ___  _ __ __ _
#                  | |_| |/ _ \| '__/ _` |
#                  |  _| | (_) | | | (_| |
#                  |_| |_|\___/|_|  \__,_|
#                  
# lean                   _/_/  _/                                
#                     _/      _/    _/_/    _/  _/_/    _/_/_/   
#                  _/_/_/_/  _/  _/    _/  _/_/      _/    _/    
#                   _/      _/  _/    _/  _/        _/    _/     
#                  _/      _/    _/_/    _/          _/_/_/      
#
#                   .o88o. oooo                               
# roman             888 `" `888                               
#                  o888oo   888   .ooooo.  oooo d8b  .oooo.   
#                   888     888  d88' `88b `888""8P `P  )88b  
#                   888     888  888   888  888      .oP"888  
#                   888     888  888   888  888     d8(  888  
#                  o888o   o888o `Y8bod8P' d888b    `Y888""8o 
#
# colossal          .d888 888                           
#                  d88P"  888                           
#                  888    888                           
#                  888888 888  .d88b.  888d888  8888b.  
#                  888    888 d88""88b 888P"       "88b 
#                  888    888 888  888 888     .d888888 
#                  888    888 Y88..88P 888     888  888 
#                  888    888  "Y88P"  888     "Y888888 
#
# nancyj          .8888b dP                            
#                 88   " 88                            
#                 88aaa  88 .d8888b. 88d888b. .d8888b. 
#                 88     88 88'  `88 88'  `88 88'  `88 
#                 88     88 88.  .88 88       88.  .88 
#                 dP     dP `88888P' dP       `88888P8 
#
#                 .-:::::':::         ...    :::::::..    :::.     
# cosmic          ;;;'''' ;;;      .;;;;;;;. ;;;;``;;;;   ;;`;;    
#                 [[[,,== [[[     ,[[     \[[,[[[,/[[['  ,[[ '[[,  
#                 `$$$"`` $$'     $$$,     $$$$$$$$$c   c$$$cc$$$c 
#                  888   o88oo,.__"888,_ _,88P888b "88bo,888   888,
#                  "MM,  """"YUMMM  "YMMMMMP" MMMM   "W" YMM   ""` 
#
# These two fonts use Unicode versions of the codepage 437 characters for a
# retro "ANSI art" vibe. They're not in the standard figlet font set but can
# readily be found on the web in figlet and TheDraw font archives.
#
# 3d                   ██████  ████                              
#                     ███░░███░░███                              
#                    ░███ ░░░  ░███   ██████  ████████   ██████  
#                   ███████    ░███  ███░░███░░███░░███ ░░░░░███ 
#                  ░░░███░     ░███ ░███ ░███ ░███ ░░░   ███████ 
#                    ░███      ░███ ░███ ░███ ░███      ███░░███ 
#                    █████     █████░░██████  █████    ░░████████
#                   ░░░░░     ░░░░░  ░░░░░░  ░░░░░      ░░░░░░░░ 
#                  
# ANSI Shadow      ███████╗██╗      ██████╗ ██████╗  █████╗ 
#                  ██╔════╝██║     ██╔═══██╗██╔══██╗██╔══██╗
#                  █████╗  ██║     ██║   ██║██████╔╝███████║
#                  ██╔══╝  ██║     ██║   ██║██╔══██╗██╔══██║
#                  ██║     ███████╗╚██████╔╝██║  ██║██║  ██║
#                  ╚═╝     ╚══════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝
